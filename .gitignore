# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# oriģinālās (neoptimizētās) fotogrāfijas — sk. scripts/optimize-images.mjs
/media-src/
# pagaidu failu pārsūtīšana
/.transfer/

# darba faili, kas nav jāpublicē (vecās bildes, pārsūtīšanas arhīvi, Claude izvades)
/_to_delete/
/update*.tgz
/Claude outputs/

# Vienreizējs imports no Google kalendāra (satur klientu vārdus)
/supabase/PALAIST-KALENDARS.sql

# no projekta izņemtās bildes, kuras lapa nerāda (rezerves kopija uz datora)
/_neizmantotas-bildes/
