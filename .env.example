# Supabase projekts (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Mājaslapas publiskā adrese (kanoniskajām saitēm, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.smaidudarbnica.lv

# E-pasta paziņojumi par jauniem pieteikumiem (resend.com → API Keys). Ja nav — pieteikumi redzami tikai panelī.
RESEND_API_KEY=
NOTIFY_EMAIL=smaidu.darbnica@gmail.com
NOTIFY_EMAIL_PRIVATE=smaidudarbniica@gmail.com
# Pēc domēna apstiprināšanas Resend: Smaidu Darbnīca <pieteikumi@smaidudarbnica.lv>
NOTIFY_FROM=

# Ceļa izdevumu aprēķins (izbraukuma ballītes). Bezmaksas atslēga: openrouteservice.org → Dashboard → API key.
# Ja nav — tiek izmantots OpenStreetMap (Nominatim + OSRM) publiskais serviss.
ORS_API_KEY=
